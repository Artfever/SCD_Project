#!/bin/sh
# Enable once per clone: git config core.hooksPath .githooks
if { git var GIT_AUTHOR_IDENT; git var GIT_COMMITTER_IDENT; } | grep -Eiq 'claude|anthropic|copilot|codex'; then
  echo "Author or committer is an AI identity." >&2
  exit 1
fi
exec bash "$(git rev-parse --show-toplevel)/scripts/check_commit_msg.sh" "$1"
